+++ b/Codigo/clsProgressBar.cls
@@ -0,0 +1,68 @@
+VERSION 1.0 CLASS
+BEGIN
+  MultiUse = -1  'True
+  Persistable = 0  'NotPersistable
+  DataBindingBehavior = 0  'vbNone
+  DataSourceBehavior  = 0  'vbNone
+  MTSTransactionMode  = 0  'NotAnMTSTransactionMode
+END
+Attribute VB_Name = "clsProgressBar"
+Attribute VB_GlobalNameSpace = False
+Attribute VB_Creatable = True
+Attribute VB_PredeclaredId = False
+Attribute VB_Exposed = False
+' Licence-free replacement for ComctlLib.ProgressBar (Min/Max/Value/Visible), drawn on a PictureBox.
+Option Explicit
+Private m_Host As Object
+Private m_Min As Double
+Private m_Max As Double
+Private m_Value As Double
+
+Public Property Set Host(ByVal pic As Object)
+    Set m_Host = pic
+    Call Redraw
+End Property
+
+Public Property Get Min() As Double
+    Min = m_Min
+End Property
+Public Property Let Min(ByVal v As Double)
+    m_Min = v
+    Call Redraw
+End Property
+
+Public Property Get Max() As Double
+    Max = m_Max
+End Property
+Public Property Let Max(ByVal v As Double)
+    m_Max = v
+    Call Redraw
+End Property
+
+Public Property Get Value() As Double
+    Value = m_Value
+End Property
+Public Property Let Value(ByVal v As Double)
+    m_Value = v
+    Call Redraw
+End Property
+
+Public Property Get Visible() As Boolean
+    If Not m_Host Is Nothing Then Visible = m_Host.Visible
+End Property
+Public Property Let Visible(ByVal v As Boolean)
+    If Not m_Host Is Nothing Then m_Host.Visible = v
+End Property
+
+Private Sub Redraw()
+    On Error Resume Next
+    If m_Host Is Nothing Then Exit Sub
+    Dim w As Double, f As Double
+    m_Host.Cls
+    If m_Max > m_Min Then f = (m_Value - m_Min) / (m_Max - m_Min)
+    If f < 0 Then f = 0
+    If f > 1 Then f = 1
+    w = m_Host.ScaleWidth * f
+    If w > 0 Then m_Host.Line (0, 0)-(w, m_Host.ScaleHeight), RGB(0, 0, 128), BF
+    m_Host.Refresh
+End Sub
