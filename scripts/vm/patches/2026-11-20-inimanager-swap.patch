+''
+'twinBASIC build: a whole-UDT swap (Temp = fileData(Min) ...) crashes with ACCESS_VIOLATION in ucrtbase when MainNode holds a dynamic array
+'(self-assignment when Min = max, or an unallocated values() array). Swap member by member, skip self swaps, and only copy values() when allocated.
+Private Sub SwapMainNodes(ByVal A As Long, ByVal B As Long)
+    If A = B Then Exit Sub
+    Dim tmpName As String
+    Dim tmpNum As Integer
+    Dim tmpValues() As ChildNode
+    tmpName = fileData(A).name
+    tmpNum = fileData(A).numValues
+    If tmpNum > 0 Then tmpValues = fileData(A).values
+    fileData(A).name = fileData(B).name
+    fileData(A).numValues = fileData(B).numValues
+    If fileData(B).numValues > 0 Then
+        fileData(A).values = fileData(B).values
+    Else
+        Erase fileData(A).values
+    End If
+    fileData(B).name = tmpName
+    fileData(B).numValues = tmpNum
+    If tmpNum > 0 Then
+        fileData(B).values = tmpValues
+    Else
+        Erase fileData(B).values
+    End If
 End Sub
 
 ''
