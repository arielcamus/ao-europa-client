{
  "name": "ao-client",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.21.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bot": "pnpm build && node apps/bot/dist/cli.js",
    "standin": "pnpm build && node tools/standin-server/dist/cli.js",
    "bot:standin": "pnpm build && node tools/run-standin.mjs",
    "bridge": "pnpm build && node packages/bridge/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
