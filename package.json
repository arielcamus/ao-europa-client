{
  "name": "ao-client",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "coverage:map": "node tools/coverage/build-map.mjs",
    "size:web": "node tools/bundle-size.mjs",
    "bot": "pnpm build && node apps/bot/dist/cli.js",
    "standin": "pnpm build && node tools/standin-server/dist/cli.js",
    "bot:standin": "pnpm build && node tools/run-standin.mjs",
    "bridge": "pnpm build && node packages/bridge/dist/cli.js",
    "build:server": "pnpm --filter @ao/protocol --filter @ao/bridge --filter @ao/standin-server build",
    "dev": "pnpm build:server && node tools/dev-web.mjs",
    "dev:standin": "pnpm build:server && node tools/dev-web.mjs --standin",
    "web:preview": "pnpm build && node tools/dev-web.mjs --standin --preview",
    "test:browser": "pnpm build && playwright test",
    "playthrough": "pnpm build && playwright test --config apps/web/e2e/playthrough.config.ts",
    "test:browser:real": "pnpm build && playwright test --config playwright.real.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "^4.0.0"
  }
}
