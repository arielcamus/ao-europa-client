diff --git a/Codigo/Hogar.bas b/Codigo/Hogar.bas
index 994e61e9..4527d3de 100644
--- a/Codigo/Hogar.bas
+++ b/Codigo/Hogar.bas
@@ -45,6 +45,17 @@ Public Function IsValidCity(ByVal CityId As e_City) As Boolean
     End With
 End Function
 
+' Post-pin backport of upstream 07009f8a (#1748, 2026-08-13, not HOO): the cities a new character may pick.
+' Our list is the pinned client's lstHogar minus Forgat (Ariel, 2026-11-21: Forgat hidden for now).
+Public Function IsValidCharacterCreationCity(ByVal CityId As e_City) As Boolean
+    If Not IsValidCity(CityId) Then Exit Function
+
+    Select Case CityId
+        Case cUllathorpe, cNix, cBanderbill, cLindos, cArghal
+            IsValidCharacterCreationCity = True
+    End Select
+End Function
+
 Public Sub goHome(ByVal UserIndex As Integer)
     On Error GoTo goHome_Err
     With UserList(UserIndex)
